<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.leave.report.wizard.form</field>
        <field name="model">hr.leave.report.wizard</field>
        <field name="arch" type="xml">
            <form string="İzin Raporu">
                <group>
                    <group>
                        <field name="date_from" attrs="{'invisible': [('start_from_hire_date', '=', True)]}"/>
                        <field name="start_from_hire_date"/>
                        <field name="date_to"/>
                        <field name="group_by" widget="radio"/>
                        <field name="state" widget="radio"/>
                        <field name="show_description"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="department_id"/>
                        <field name="holiday_status_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="PDF" type="object"
                            class="btn-primary"/>
                    <button name="action_print_xlsx" string="Excel" type="object"
                            class="btn-primary"/>
                    <button string="Vazgeç" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leave_report_wizard" model="ir.actions.act_window">
        <field name="name">İzin Raporu</field>
        <field name="res_model">hr.leave.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
